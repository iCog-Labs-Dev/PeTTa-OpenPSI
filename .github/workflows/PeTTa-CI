name: PeTTa CI

on:
  pull_request:
    branches: 
      - main
      - feat/workflow-Integration
  push:
    branches: [ main ]

jobs:
  test:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout your repository
        uses: actions/checkout@v4

      - name: Setup SWI-Prolog
        uses: logtalk-actions/setup-swi-prolog@v2

      - name: Clone PeTTa
        run: |
          git clone https://github.com/patham9/PeTTa.git
          cd PeTTa
          chmod +x run.sh
          echo "$PWD" >> $GITHUB_PATH

      - name: Verify run.sh
        run: |
          which run.sh
          swipl --version

      - name: Run Test Suite
        run: |
          python3 scripts/run-tests.py