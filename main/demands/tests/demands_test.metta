!(import! &self ../../../psi-utilities/psi_utils)
!(import! &self ../demands)
!(import! &self ../../psi-config)

!(bind! &demandSpace (new-space))
!(bind! &registryDemandSpace (new-space))
!(demand-registry)
!(addDemand &demandSpace energy 0.6)
!(addDemand &demandSpace affiliation 0.5)
!(addDemand &demandSpace competence 0.2)
!(skipDemand &demandSpace competence)
!(initialize-demands &registryDemandSpace)
!(collapse (get-atoms &registryDemandSpace))
!(test (getDemandByName &registryDemandSpace energy) (demand energy 0.4 0.7 0.85))
!(test (getDemandByName &registryDemandSpace energy) (demand energy 0.4 0.7 0.85))
!(test (get-demand-config energy) (demand-config energy 0.4 0.7 0.85 energy-demand-updater))
!(test (list-demands) (affiliation energy competence certainty integrity))

!(test (exists-In &demandSpace (demand energy 0.4 0.7 0.6)) True)
!(test (exists-In &demandSpace (demand competence 0.3 0.5 0.2)) True)
!(test (getAllDemands &demandSpace )  ((demand energy 0.4 0.7 0.6) (demand affiliation 0.5 0.6 0.5) (demand competence 0.3 0.5 0.2)))
!(test (exists-In &demandSpace (skip competence)) True)
!(test (getAllDemands &registryDemandSpace) ((demand affiliation 0.5 0.6 0.55) (demand energy 0.4 0.7 0.85) (demand competence 0.3 0.5 0.95) (demand certainty 0.3 0.7 0.5) (demand integrity 0.3 0.7 0.5)))

!(setDemandValue &demandSpace energy 0.8)
!(test (exists-In &demandSpace (demand energy 0.4 0.7 0.6)) False)
!(test (exists-In &demandSpace (demand energy 0.4 0.7 0.8)) True)

!(test (fetch-demand &demandSpace energy)  (demand energy 0.4 0.7 0.8))
!(test (fetch-demand-val &demandSpace energy) 0.8)
!(test (getEnabledDemands &demandSpace) ((demand affiliation 0.5 0.6 0.5) (demand energy 0.4 0.7 0.8)))
